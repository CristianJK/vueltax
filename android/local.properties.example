# Copia este archivo como local.properties (no se versiona).
# Android Studio añade sdk.dir automáticamente al abrir el proyecto.

# URL base de la API pública. En debug se permite HTTP en claro solo hacia este host.
# Emulador -> backend en el mismo equipo: http://10.0.2.2:8080/
# Dispositivo físico -> IP del equipo o del servidor en la red: http://192.168.1.50:8080/
API_BASE_URL=http://10.0.2.2:8080/
