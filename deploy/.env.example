# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.

# --- Obligatorias ---
# Contraseña de PostgreSQL:           openssl rand -hex 24
POSTGRES_PASSWORD=
# Token Bearer de administración (mínimo 32 caracteres):   openssl rand -hex 32
ADMIN_TOKEN=

# --- Proxy HTTPS ---
# Dominio público de la API (p. ej. api.example.com). Con "localhost" Caddy usa un
# certificado interno, útil solo para pruebas.
SITE_ADDRESS=localhost
# Puertos del host para Caddy. Cámbialos si 80/443 ya están ocupados (así no se podrá
# obtener un certificado público automáticamente).
HTTP_PORT=80
HTTPS_PORT=443
# Puerto local (solo 127.0.0.1) de la API, para administración y seed.
API_PORT=8080

# --- Opcionales ---
POSTGRES_DB=vueltax
POSTGRES_USER=vueltax
# Orígenes web autorizados por CORS, separados por coma. Vacío = CORS cerrado.
CORS_ALLOWED_ORIGINS=
# Solicitudes por minuto y por IP.
RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=30
# Job diario de tasas de cambio (Frankfurter + TRM de datos.gov.co).
RATES_JOB_ENABLED=true
RATES_JOB_TIME_UTC=23:30
RATES_BASES=USD,EUR
